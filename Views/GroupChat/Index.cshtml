@{
    ViewData["Title"] = "Group Chat";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        swamp: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            300: '#86efac',
                            400: '#4ade80',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }

        window.currentUser = {
            username: '@ViewBag.Username',
            avatar: '@ViewBag.ProfilePictureUrl'
        };
    </script>
</head>
<body class="bg-swamp-50 h-screen">
    <div class="max-w-7xl mx-auto h-full flex">
        <!-- Левая панель (только групповой чат) -->
        <div class="w-1/3 bg-white border-r border-swamp-100 flex flex-col">
            <div class="p-6 border-b border-swamp-100">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-swamp-900">Group Chat</h2>
                    <a href="/Account/Logout" class="text-sm text-swamp-600 hover:underline">Logout</a>
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-4">
                <div class="p-4 bg-swamp-50 rounded-lg border border-swamp-200">
                    <p class="text-sm text-swamp-600">Welcome to the common chat! All online users are here.</p>
                </div>
            </div>
        </div>

        <!-- Правая панель: сообщения и ввод -->
        <div class="flex-1 flex flex-col">
            <div class="p-4 bg-white border-b border-swamp-100 flex items-center space-x-3">
                <div>
                    <h3 class="font-semibold text-swamp-900">Group Chat</h3>
                    <div id="typingIndicator" class="text-sm text-swamp-500 hidden">
                        <span class="animate-pulse">is typing...</span>
                    </div>
                </div>
            </div>

            <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-4 bg-swamp-50">
                <!-- Сообщения будут добавляться динамически -->
            </div>

            <div class="p-4 bg-white border-t border-swamp-100">
                <div class="flex space-x-2">
                    <input type="text" id="messageInput" placeholder="Type your message..."
                           class="flex-1 pl-4 pr-12 py-2 bg-swamp-100 rounded-full border-none focus:ring-2 focus:ring-swamp-400 placeholder-swamp-500 text-swamp-900">
                    <button id="sendButton" class="p-2 bg-swamp-500 text-white rounded-full hover:bg-swamp-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" transform="rotate(90)">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .build();

            const sendButton = document.getElementById("sendButton");
            const messageInput = document.getElementById("messageInput");
            const messagesContainer = document.getElementById("messages-container");

            // Disable send until connected
            sendButton.disabled = true;

            connection.on("ReceiveMessage", (user, userIcon, message) => {
                const isMe = user === window.currentUser.username;
                const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                const msgDiv = document.createElement("div");
                msgDiv.className = `flex ${isMe ? 'justify-end' : 'justify-start'}`;

                if (isMe) {
                    const avatarStr = userIcon ? userIcon : '/images/green-toad-sad.svg';
                    msgDiv.innerHTML = `
                        <div class="flex items-end max-w-[70%] space-x-2">
                            <div class="flex flex-col items-end">
                                <span class="text-xs text-swamp-500 mb-1">${timeStr}</span>
                                <div class="p-3 bg-swamp-500 text-white rounded-2xl rounded-tr-sm break-words">
                                    ${escapeHtml(message)}
                                </div>
                            </div>
                            <img src="${avatarStr}" alt="${user}" class="w-8 h-8 rounded-full mb-1">
                        </div>
                    `;
                } else {
                    const avatarStr = userIcon ? userIcon : '/images/green-toad-sad.svg';
                    msgDiv.innerHTML = `
                        <div class="flex items-end max-w-[70%] space-x-2">
                            <img src="${avatarStr}" alt="${user}" class="w-8 h-8 rounded-full mb-1">
                            <div class="flex flex-col items-start">
                                <span class="text-xs text-swamp-500 mb-1 font-semibold">${user} <span class="font-normal ms-1">${timeStr}</span></span>
                                <div class="p-3 bg-white text-swamp-900 border border-swamp-200 rounded-2xl rounded-tl-sm break-words">
                                    ${escapeHtml(message)}
                                </div>
                            </div>
                        </div>
                    `;
                }
                messagesContainer.appendChild(msgDiv);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            });

            connection.start().then(() => {
                sendButton.disabled = false;
            }).catch(err => {
                console.error(err.toString());
            });

            const sendMessage = () => {
                const text = messageInput.value.trim();
                if (!text) return;
                
                connection.invoke("SendMessage", window.currentUser.username, window.currentUser.avatar, text).catch(err => console.error(err.toString()));
                
                messageInput.value = "";
                messageInput.focus();
            };

            sendButton.addEventListener("click", sendMessage);

            messageInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") {
                    sendMessage();
                }
            });

            function escapeHtml(unsafe) {
                return unsafe
                     .replace(/&/g, "&amp;")
                     .replace(/</g, "&lt;")
                     .replace(/>/g, "&gt;")
                     .replace(/"/g, "&quot;")
                     .replace(/'/g, "&#039;");
            }
        });
    </script>
</body>
</html>